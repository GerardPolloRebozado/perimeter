# =====================================================================
# AREA .gitignore
# Package-specific rules live in that package's own .gitignore.
# =====================================================================

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Editors / IDEs ----------
.idea/
.vscode/
*.iml
*.iws
*.ipr
# VS Code Java/Kotlin extension compiles into bin/
packages/**/bin/
spike-*/**/bin/

# ---------- Secrets & local config ----------
.env
.env.*
!.env.example
**/config/local.yaml
**/config/*.local.yaml

# ---------- Logs & test reports ----------
*.log
coverage/

# ---------- Node / NestJS (pnpm) ----------
node_modules/
dist/
.pnpm-store/

# ---------- JVM / Gradle / Kotlin ----------
.gradle/
.kotlin/
build/
out/
local.properties
*.gradle.kts.sha1

# ---------- Android ----------
captures/
.externalNativeBuild/
.cxx/

# ---------- iOS / Xcode ----------
xcuserdata/
DerivedData/

# ---------- Rust ----------
target/
debug/
**/*.rs.bk
*.pdb

# ---------- Databases ----------
*.sqlite
*.sqlite-*

# ---------- Generated code (OpenAPI) ----------
.openapi-generator/

# ---------- Dev environment (devenv / direnv) ----------
.devenv*
devenv.local.nix
devenv.local.yaml
.direnv/
.pre-commit-config.yaml

# ---------- Course material ----------
docs/area-bootstrap.pdf

# =====================================================================
# Surface Volume .gitignore
# Package-specific rules live in that package's own .gitignore.
# =====================================================================

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Editors / IDEs ----------
.idea/
.vscode/
*.iml
*.iws
*.ipr
# VS Code Java/Kotlin extension compiles into bin/
packages/**/bin/
spike-*/**/bin/

# ---------- Secrets & local config ----------
.env
.env.*
!.env.example
**/config/local.yaml
**/config/*.local.yaml

# ---------- Logs & test reports ----------
*.log
coverage/

# ---------- Node / NestJS (pnpm) ----------
node_modules/
dist/
.pnpm-store/

# ---------- JVM / Gradle / Kotlin ----------
.gradle/
.kotlin/
build/
out/
local.properties
*.gradle.kts.sha1

# ---------- Android ----------
captures/
.externalNativeBuild/
.cxx/

# ---------- iOS / Xcode ----------
xcuserdata/
DerivedData/

# ---------- Rust ----------
target/
debug/
**/*.rs.bk
*.pdb

# ---------- Databases ----------
*.sqlite
*.sqlite-*

# ---------- Generated code (OpenAPI) ----------
.openapi-generator/

# ---------- Dev environment (devenv / direnv) ----------
.devenv*
devenv.local.nix
devenv.local.yaml
.direnv/
.pre-commit-config.yaml

# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

#nestjs
node_modules
dist

# Gradle
.gradle/
build/
*.gradle.kts.sha1
!gradle/libs.versions.toml
local.properties

# Docker
.dockerignore

# Environment
.env

# OpenAPI generator
.openapi-generator/
.openapi-generator-ignore

# Kotlin
*.iws
*.iml
*.ipr
out/
kotlin-js-store/

# ---------- Course material ----------
docs/surface-volume-bootstrap.pdf
